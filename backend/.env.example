DATABASE_URL=sqlite:///./controle_financeiro.db
FRONTEND_ORIGIN=http://localhost:5173

# DEBUG=true (padrão) faz o cookie de sessão NÃO exigir HTTPS - necessário
# em dev local (http://localhost). Em produção, definir DEBUG=false pra
# forçar o cookie Secure (senão o navegador aceita ele sendo roubado em
# qualquer conexão HTTP não criptografada).
DEBUG=true

# usados só pelo seed inicial (app/seed.py)
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=troque-esta-senha

# Etapa 3 (Pluggy - Conector 200) - preencher quando criar a conta em
# https://dashboard.pluggy.ai. Sem essas duas, POST /accounts/sync responde
# 501 e o import manual de CSV/OFX segue funcionando normalmente.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Etapa 4 (Telegram) - preencher quando integrar
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Integração Nero -> Saas1 (POST /integrations/nero/transactions).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# O MESMO valor precisa ser configurado no Worker do Nero como secret
# SAAS1_INTEGRATION_TOKEN (wrangler secret put SAAS1_INTEGRATION_TOKEN).
NERO_INTEGRATION_TOKEN=

# Notificações por email (Gmail SMTP). SMTP_APP_PASSWORD é uma App
# Password gerada em myaccount.google.com/apppasswords (exige 2FA na
# conta remetente) - NUNCA a senha normal da conta. Sem essas duas
# variáveis, notificações só ficam logadas, não são enviadas.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
NOTIFY_EMAIL=

# Limiares dos gatilhos de notificação (todos opcionais, com default)
LOW_BALANCE_THRESHOLD=0
LARGE_TRANSACTION_THRESHOLD=500
SUBSCRIPTION_ALERT_DAYS=3
UNUSUAL_SPEND_MULTIPLIER=2

# Login com Google (allowlist de 1 email só - uso pessoal). Client ID
# criado em console.cloud.google.com (OAuth consent screen "Testing" +
# credencial "Web application"). Não precisa de client secret - o fluxo
# usa Google Identity Services + verificação do ID token no backend.
GOOGLE_CLIENT_ID=
ALLOWED_LOGIN_EMAIL=

# Keep-alive (Etapa 3.5) - evita o free tier do Render dormir após 15 min
# sem tráfego. Preencher só em produção, com a própria URL pública do
# backend (ex: https://saas1-backend.onrender.com) - em dev local, deixar
# vazio (o job vira no-op).
SELF_PING_URL=
