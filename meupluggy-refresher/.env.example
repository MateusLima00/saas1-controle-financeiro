# Segredo pra proteger o POST /atualizar deste serviço. Gerar com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
REFRESH_TOKEN=

# Login no meu.pluggy.ai (passwordless, link mágico por email).
MEU_PLUGGY_EMAIL=
# Caixa que recebe o link (default: igual MEU_PLUGGY_EMAIL).
MEU_PLUGGY_IMAP_EMAIL=
# App Password do Gmail dessa caixa (myaccount.google.com/apppasswords) -
# NUNCA a senha normal da conta. Essa é a credencial mais sensível de todo
# esse serviço; é por isso que ele fica isolado do backend principal.
MEU_PLUGGY_IMAP_APP_PASSWORD=

# Callback pro backend principal (Saas1), disparado depois que a
# atualização termina, pra sincronizar os dados frescos na hora em vez de
# esperar o job de 20 min. Opcional - sem isso, só loga e segue o job.
SAAS1_API_URL=https://saas1-mlc-backend-7k2p.onrender.com
SAAS1_CALLBACK_TOKEN=
